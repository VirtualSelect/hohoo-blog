  "ui.a3910125df": {
    "message": "關於 Hohoo"
  },
  "ui.b2830b25e0": {
    "message": "Hohoo：從 Java 到 AI，公開學習、實驗與實作。"
  },
  "ui.d22f242c15": {
    "message": "你好，我是 Hohoo。"
  },
  "ui.6aba6b62c2": {
    "message": "平常主要寫 Java，喜歡把感興趣的想法做出來。最近更關注 AI 應用，也開始閱讀大型語言模型與具身智慧的資料。"
  },
  "ui.9282b6e323": {
    "message": "這裡記錄遇到的問題、查閱的資料和嘗試的方法。區分資料、計畫與已驗證的結論，也保留尚未解答的問題。"
  },
  "ui.986c64be2d": {
    "message": "可以打開看看的作品"
  },
  "ui.83da62e1e4": {
    "message": "學習、實驗、實作、記錄。"
  },
  "ui.51d0291ad7": {
    "message": "從具體問題出發，保留來源，用小型實驗驗證，再整理成可重複使用的紀錄。"
  },
  "ui.f07f7fbc5f": {
    "message": "手邊的工具"
  },
  "ui.84eb68552f": {
    "message": "程式之外"
  },
  "ui.27250fc8fe": {
    "message": "喜歡聽音樂、尋找美食，也享受安靜閱讀的時間。認真做事，也為生活留白。"
  },
  "ui.6c155ab779": {
    "message": "更多關於 Hohoo"
  },
  "ui.b9171eebbb": {
    "message": "連結學習與實作的外部 AI 訊息，保留來源及內容歸屬。"
  },
