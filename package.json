{
  "name": "hohoo-blog",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "scripts": {
    "start": "npm run dev --prefix apps/web",
    "start:en": "npm run dev --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "serve": "npm run start --prefix apps/web",
    "preview": "npm run start --prefix apps/web",
    "news:collect": "node scripts/news/collect.mjs",
    "news:render": "node scripts/news/render.mjs",
    "news:translate": "node scripts/news/translate.mjs",
    "news:check": "node scripts/news/render.mjs --check",
    "news:reject": "node scripts/news/render.mjs --reject",
    "test:news": "node --test tests/news.test.mjs tests/news-full-feed.test.mjs tests/news-feed.test.cjs",
    "i18n:check": "node scripts/i18n/check.cjs",
    "start:tw": "npm run dev --prefix apps/web",
    "test:web": "npm run prepare:content --prefix apps/web && npm test --prefix apps/web"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "rss-parser": "3.13.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@iconify/react": "^5.0.1",
    "@types/three": "0.186.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
