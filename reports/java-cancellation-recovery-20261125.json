{
  "study": "java-cancellation-recovery",
  "version": 1,
  "date": "2026-11-25",
  "scope": "One keyed loopback effect, cooperative local JVM processes and serialized cancellation. Each recovery runs in a new JVM. No asynchronous in-flight interruption, compensation or power-loss test.",
  "policy": "Persist dispatch-started before sending. A cancelled intent never resends or writes new successful history. With no durable receipt, a started attempt has unknown outcome. A durable receipt is preserved.",
  "upstream": {
    "repository": "https://github.com/VirtualSelect/hohoo-ai-lab",
    "commit": "0d4009cf840052c3111bbfc40dce900326daa3ae",
    "directory": "demos/13-durable-dispatch",
    "sha256LF": {
