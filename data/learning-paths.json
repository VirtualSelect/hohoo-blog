  {
    "id": "understand",
    "title": "LLM",
    "en": "LLM",
    "domain": "llm",
    "brand": "UNDERSTAND",
    "intro": "理解模型的输入、表示与推理机制。",
    "english": "Understand model inputs, representations and inference.",
    "steps": [
      {
        "id": "kv-cache",
        "doc": "llm/kv-cache",
        "outcome": "估算 K/V 数组容量，区分会话记忆和计算复用。",
        "outcomeEn": "Estimate K/V payload and distinguish conversation context from computation reuse.",
        "outcomeTw": "估算 K/V 陣列容量，區分會話記憶與計算重用。",
        "prerequisites": [],
        "followUps": [
          "doc:llm/longest-prefix-reuse",
          "doc:llm/prefix-cache-byte-budget",
          "doc:llm/prefix-cache-admission"
        ]
      },
      {
        "id": "causal-mask-lab",
        "doc": "llm/causal-mask-lab",
        "outcome": "用未来信息泄漏反例检验因果掩码。",
        "outcomeEn": "Test causal masking with a future-information leakage counterexample.",
        "outcomeTw": "用未來資訊洩漏反例檢驗因果遮罩。",
        "prerequisites": ["doc:llm/kv-cache"],
        "followUps": ["doc:llm/kv-cache-equivalence"]
      },
      {
        "id": "kv-cache-equivalence",
        "doc": "llm/kv-cache-equivalence",
        "outcome": "逐步比较完整重算与增量计算的数值结果。",
        "outcomeEn": "Compare full and incremental computation step by step.",
        "outcomeTw": "逐步比較完整重算與增量計算的數值結果。",
        "prerequisites": ["doc:llm/causal-mask-lab"],
        "followUps": ["doc:llm/sliding-cache-positions"]
      },
      {
        "id": "sliding-cache-positions",
        "doc": "llm/sliding-cache-positions",
        "outcome": "滑动窗口裁剪后仍保留正确位置语义。",
        "outcomeEn": "Preserve position semantics after sliding-window eviction.",
        "outcomeTw": "滑動視窗裁切後仍保留正確位置語義。",
        "prerequisites": ["doc:llm/kv-cache-equivalence"],
        "followUps": ["doc:llm/prefix-cache-invalidation"]
      },
      {
        "id": "prefix-cache-invalidation",
        "doc": "llm/prefix-cache-invalidation",
        "outcome": "识别模型、位置与输入变更后的失效条件。",
        "outcomeEn": "Identify invalidation conditions after model, position or input changes.",
        "outcomeTw": "辨識模型、位置與輸入變更後的失效條件。",
        "prerequisites": ["doc:llm/sliding-cache-positions"],
        "followUps": ["doc:llm/longest-prefix-reuse"]
      },
      {
        "id": "longest-prefix-reuse",
        "doc": "llm/longest-prefix-reuse",
        "outcome": "匹配最长有效前缀并续算剩余 Token。",
        "outcomeEn": "Match the longest valid prefix and compute the remaining tokens.",
        "outcomeTw": "比對最長有效前綴並續算剩餘 Token。",
        "prerequisites": ["doc:llm/prefix-cache-invalidation"],
        "followUps": ["doc:llm/prefix-cache-byte-budget"]
      },
      {
        "id": "prefix-cache-byte-budget",
        "doc": "llm/prefix-cache-byte-budget",
        "outcome": "按数组字节数限制 LRU，解释工作集放不下时的零命中。",
        "outcomeEn": "Budget array bytes in LRU and explain zero hits when the working set does not fit.",
        "outcomeTw": "依陣列位元組數限制 LRU，解釋工作集放不下時的零命中。",
        "prerequisites": ["doc:llm/longest-prefix-reuse"],
        "followUps": ["doc:llm/prefix-cache-admission"]
      },
      {
        "id": "prefix-cache-admission",
        "doc": "llm/prefix-cache-admission",
        "outcome": "同时判断数值等价、计算节省与实测时间。",
        "outcomeEn": "Evaluate numerical equivalence, saved work and measured time separately.",
        "outcomeTw": "同時判斷數值等價、計算節省與實測時間。",
        "prerequisites": ["doc:llm/prefix-cache-byte-budget"]
      },
      {
        "id": "context-position-experiment",
        "doc": "llm/context-position-experiment",
        "outcome": "区分计划、尝试、有效响应，保留限流后的不完整结果。",
        "outcomeEn": "Separate planned, attempted and valid calls, including rate-limited incomplete runs.",
        "outcomeTw": "區分計畫、嘗試與有效回應，保留限流後的不完整結果。",
        "prerequisites": [],
        "followUps": ["doc:llm/context-position-paired-protocol"]
      },
      {
        "id": "context-position-paired-protocol",
        "doc": "llm/context-position-paired-protocol",
        "outcome": "复核 24 次真实对照，说明全对结果的测量天花板。",
        "outcomeEn": "Audit 24 real paired calls and explain a ceiling effect.",
        "outcomeTw": "複核 24 次真實對照，說明全對結果的測量天花板。",
        "prerequisites": ["doc:llm/context-position-experiment"],
        "followUps": ["doc:llm/context-similar-distractors"]
      },
      {
        "id": "context-similar-distractors",
        "doc": "llm/context-similar-distractors",
        "outcome": "检查 128 项离线实验设计，不把准备完成当模型结果。",
        "outcomeEn": "Inspect a 128-case offline protocol without claiming model results.",
        "outcomeTw": "檢查 128 項離線實驗設計，不將準備完成當成模型結果。",
        "prerequisites": ["doc:llm/context-position-paired-protocol"]
      },
