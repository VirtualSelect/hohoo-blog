[
  {
    "id": "applications",
    "title": "AI 应用开发",
    "en": "AI Applications",
    "intro": "从已有的编程基础出发，按模型调用、输出控制、知识检索和效果评估的顺序推进。",
    "english": "Start with programming fundamentals, then explore model calls, output control, retrieval and evaluation.",
    "steps": [
      {
        "id": "first-call",
        "doc": "ai-apps/java-first-llm",
        "outcome": "发送请求、解析回答，并正确传递多轮历史。",
        "outcomeEn": "Send a request, parse the answer and pass conversation history.",
        "outcomeTw": "發送請求、解析回答，並正確傳遞多輪歷史。",
        "prerequisites": [],
        "followUps": ["doc:ai-apps/java-structured-output"]
      },
      {
        "id": "structured-output",
        "doc": "ai-apps/java-structured-output",
        "outcome": "把传输、JSON 结构和业务验收分开。",
        "outcomeEn": "Separate transport, JSON structure and business acceptance.",
        "outcomeTw": "將傳輸、JSON 結構與業務驗收分開。",
        "prerequisites": ["doc:ai-apps/java-first-llm"],
        "followUps": ["doc:ai-apps/java-transactional-history"]
      },
      {
        "id": "java-transactional-history",
        "doc": "ai-apps/java-transactional-history",
        "outcome": "让一次问答原子提交，失败不留下半轮。",
        "outcomeEn": "Commit a whole turn atomically without leaving partial history.",
        "outcomeTw": "讓一次問答原子提交，失敗不留下半輪。",
        "prerequisites": ["doc:ai-apps/java-structured-output"],
        "followUps": ["doc:ai-apps/java-concurrent-history"]
      },
      {
        "id": "java-concurrent-history",
        "doc": "ai-apps/java-concurrent-history",
        "outcome": "用版本票据实现先提交者获胜，说明与串行的区别。",
        "outcomeEn": "Use version tickets for first-committer-wins and contrast serialization.",
        "outcomeTw": "用版本票據實作先提交者勝出，說明與序列執行的差異。",
        "prerequisites": ["doc:ai-apps/java-transactional-history"],
        "followUps": ["doc:ai-apps/java-tool-boundary"]
      },
      {
        "id": "java-tool-boundary",
        "doc": "ai-apps/java-tool-boundary",
        "outcome": "限制工具白名单、参数与预算，区分超时和真正停止。",
        "outcomeEn": "Bound tools, arguments and budgets; distinguish timeout from termination.",
        "outcomeTw": "限制工具白名單、參數與預算，區分逾時和真正停止。",
        "prerequisites": ["doc:ai-apps/java-structured-output"],
        "followUps": ["doc:ai-apps/java-retrieval-evidence"]
      },
      {
        "id": "java-retrieval-evidence",
        "doc": "ai-apps/java-retrieval-evidence",
        "outcome": "复算 BM25 检索和无答案误命中，识别玩具语料的局限。",
        "outcomeEn": "Recompute BM25 retrieval and false hits on unanswerable toy queries.",
        "outcomeTw": "重算 BM25 檢索與無答案誤命中，辨識玩具語料的侷限。",
        "prerequisites": ["doc:ai-apps/java-first-llm"],
        "followUps": ["doc:ai-apps/java-grounded-claims"]
      },
      {
        "id": "java-grounded-claims",
        "doc": "ai-apps/java-grounded-claims",
        "outcome": "校验证据与声明对应，而不把规则匹配当语义蕴含。",
        "outcomeEn": "Validate claim–evidence correspondence without claiming semantic entailment.",
        "outcomeTw": "校驗證據與聲明對應，不將規則比對當成語義蘊含。",
        "prerequisites": ["doc:ai-apps/java-retrieval-evidence"],
        "followUps": ["doc:ai-apps/java-streaming-boundary"]
      },
      {
        "id": "java-streaming-boundary",
        "doc": "ai-apps/java-streaming-boundary",
        "outcome": "区分流式预览与可提交的完整回答。",
        "outcomeEn": "Separate streamed previews from a complete, committable answer.",
        "outcomeTw": "區分串流預覽與可提交的完整回答。",
        "prerequisites": ["doc:ai-apps/java-structured-output"],
        "followUps": ["doc:ai-apps/java-stream-session-ownership"],
        "reviewNotice": {
          "date": "2026-10-06",
          "text": [
            "复核发现：固定版本的 Gson 解析路径仍会接纳字符串中未转义的控制字符，已有通过项不代表严格 JSON 合规。详见第九篇的复核边界。",
            "Review: the pinned Gson parsing path still accepts unescaped control characters in strings. Passing the recorded cases does not establish strict JSON compliance. See the review boundary in article nine.",
            "複核發現：固定版本的 Gson 解析路徑仍會接受字串中未跳脫的控制字元，既有通過項不代表嚴格 JSON 合規。詳見第九篇的複核邊界。"
          ],
          "href": "/docs/ai-apps/java-stream-session-ownership"
        }
      },
      {
        "id": "java-stream-session-ownership",
        "doc": "ai-apps/java-stream-session-ownership",
        "outcome": "比较三种会话策略，阻止旧回调覆盖当前请求。",
        "outcomeEn": "Compare three session policies and reject callbacks from superseded requests.",
        "outcomeTw": "比較三種會話策略，阻止舊回呼覆蓋目前請求。",
        "prerequisites": ["doc:ai-apps/java-streaming-boundary"],
        "followUps": ["doc:ai-apps/java-transport-cancellation"]
      },
      {
        "id": "java-transport-cancellation",
        "doc": "ai-apps/java-transport-cancellation",
        "outcome": "区分本地取消、连接停止和远端任务终止。",
        "outcomeEn": "Distinguish local cancellation, transport shutdown and remote termination.",
        "outcomeTw": "區分本機取消、連線停止和遠端任務終止。",
        "prerequisites": ["doc:ai-apps/java-stream-session-ownership"],
        "reviewNotice": {
          "date": "2026-10-06",
          "text": [
            "固定版本仍有复现限制：运行脚本依赖本机 Maven 路径并强制离线；独立审计未自动核对源码指纹。继承的 Gson 解析边界见第九篇。本文记录不构成跨机器安装或严格 JSON 合规的证明。",
            "The pinned runner depends on a machine-specific Maven path and forces offline mode; its audit does not verify source hashes. The inherited Gson parsing boundary is discussed in article nine. These records do not establish portable setup or strict JSON compliance.",
            "固定版本仍有重現限制：執行腳本依賴本機 Maven 路徑並強制離線；獨立稽核未自動核對原始碼指紋。繼承的 Gson 解析邊界見第九篇。本文紀錄不構成跨機器安裝或嚴格 JSON 合規的證明。"
          ],
          "href": "/docs/ai-apps/java-stream-session-ownership"
        }
      },
      {
