{
  "name": "hohoo-web",
  "private": true,
  "scripts": {
    "prepare:content": "node scripts/content.mjs",
    "dev": "npm run prepare:content && next dev --webpack -p 4181",
    "build": "npm run prepare:content && next build --webpack",
    "start": "next start -p 4181",
    "test": "node --test tests/*.test.mjs",
    "format:check": "prettier --check app components runtime lib scripts tests next.config.mjs",
    "test:routes": "node scripts/verify-routes.mjs"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "marked": "^17.0.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.17.0",
    "prismjs": "1.30.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
